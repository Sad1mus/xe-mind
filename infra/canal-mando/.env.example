# infra/canal-mando — config del canal de mando de Xe
# GUARDA-005: TODO vive aquí, nada hardcodeado. NUNCA commitear el .env real.
# Copiar a .env y rellenar. En prod, usar un secrets manager, no un archivo plano.

# --- Identidad del canal (DEC-012) ---
TELEGRAM_BOT_TOKEN=            # secreto CRÍTICO = llave maestra de la agencia. Rotar ante cualquier sospecha.
TELEGRAM_ALLOWED_CHAT_IDS=     # CSV de chat_id autorizados, ej: 123456789,987654321. El bot ignora todo lo demás.

# --- Modelo / cerebro (AUTENTICACIÓN POR SUSCRIPCIÓN — NO API key) ---
# El canal usa el token de `claude setup-token` (plan Max). NUNCA se factura por API.
CLAUDE_CODE_OAUTH_TOKEN=       # token de suscripción de `claude setup-token`. Secreto. En la VPS: 600.
ANTHROPIC_API_KEY=             # DEPRECADO / NO USAR — agent.ts borra esta var de la env del hijo a propósito.
XE_SYSTEM_PROMPT_PATH=../../CLAUDE.md   # el system prompt = la constitución de Xe (en contenedor: /repo/CLAUDE.md)
XE_REPO_CWD=../../..                    # working dir del agente = repo Agencia (en contenedor: /repo)
CONFIRM_TIMEOUT_MS=300000              # ventana para el 2º OK humano (doble gate); sin respuesta => NO ejecuta

# --- Docker (host) ---
XE_REPO_HOST_PATH=/srv/xe-mind         # ruta del repo en la VPS a montar read-only en /repo

# --- Modo de ejecución (rollout por fases — DEC-012) ---
# read_only | reversible | money_double_gate
EXEC_MODE=read_only

# --- Topes duros (GUARDA-006). Sin valor => el canal se bloquea, no asume. ---
CAP_USD_PER_ACTION=            # monto máx por una sola acción de dinero
CAP_USD_PER_DAY=               # gasto $ real máx por día (todas las acciones)
CAP_USD_PER_CLIENT_PER_DAY=    # tope por cliente/día (evita cobros en cascada a uno)
CAP_TOKENS_PER_SESSION=        # gasto de tokens del LLM por sesión
CAP_TOKENS_PER_DAY=            # gasto de tokens del LLM por día
CAP_OUTBOUND_ACTIONS_PER_HOUR= # nº máx de acciones de cara afuera (cobros/mensajes/deploys) por hora

# --- Kill switch (GUARDA-006) ---
KILL_SWITCH_PATH=./KILL        # si este archivo existe, se aborta toda ejecución en curso

# --- Credenciales por tier (mínimo privilegio, GUARDA-005). Cada una con su scope. ---
# El agente NO recibe CRED_MONEY hasta que un humano confirma una acción de dinero.
CRED_READ=                     # solo lectura (métricas, substrato)
CRED_CLIENT=                   # operaciones de cliente reversibles
CRED_MONEY=                    # Stripe/payouts — detrás del doble gate
CRED_DEPLOY=                   # deploys

# --- Residencia / teatro (GUARDA-002) ---
TEATRO=americas                # americas | emea | latam — decide región de ejecución y de datos
SUBSTRATE_PATH=../../vault     # dónde se lee/escribe el handoff (§7)
AUDIT_LOG_PATH=./audit.ndjson  # log append-only de toda acción
